model Test {
    id          String     @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    description String
    status      TestStatus
    isDeleted   Boolean    @default(false)
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    @@map("Test")
}

enum TestStatus {
    Pending
    Complete
}

